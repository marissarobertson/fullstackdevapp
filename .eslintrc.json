{
 "root": true,
 "ignorePatterns": ["dist", "node_modules", "coverage", "backend/coverage"],
 "env": {
 "browser": true
},
 "parserOptions": {
 "ecmaVersion": "latest",
 "sourceType": "module"
},
 "extends": [
 "eslint:recommended",
 "plugin:react/recommended",
 "plugin:react/jsx-runtime",
 "plugin:jsx-a11y/recommended",
 "prettier"
],
 "settings": {
 "react": {"version": "detect"
}
},
 "overrides": [
{
 "files": ["*.js", "*.jsx"]
}
]
}
 
